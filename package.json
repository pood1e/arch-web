    "lint": "buf lint && biome check .",
    "format": "biome check --write .",
    "test": "npm run generate && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@fontsource-variable/geist": "5.3.0",
