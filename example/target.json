{
  "title": "目标架构",
  "baseline": "示例商城 · 按领域拆分",
  "repositories": [
    {
      "id": "shop-web",
      "url": "https://gitlab.example.com/shop/web",
      "branch": "main",
      "summary": "商城前端"
    },
    {
      "id": "shop-deploy",
      "url": "https://gitlab.example.com/shop/deploy",
      "branch": "main",
      "summary": "部署编排与中间件配置"
    },
    {
      "id": "shop-catalog",
      "url": "https://gitlab.example.com/shop/catalog",
      "branch": "main",
      "summary": "商品服务"
    },
    {
      "id": "shop-order",
      "summary": "订单、通知与支付模拟器，规划中"
    }
  ],
  "nodes": [
    {
      "id": "customer",
      "kind": "NODE_KIND_EXTERNAL",
      "title": "顾客",
      "subtitle": "浏览器 · App",
      "icon": "user",
      "description": "浏览商品、下单与支付。"
    },
    {
      "id": "operator",
      "kind": "NODE_KIND_EXTERNAL",
      "title": "运营人员",
      "subtitle": "运营后台 · 看板",
      "icon": "user",
      "description": "维护商品、处理订单并查看看板。"
    },
    {
      "id": "cluster",
      "kind": "NODE_KIND_CLUSTER",
      "title": "K3s 集群",
      "subtitle": "三节点",
      "icon": "k3s",
      "description": "承载商城全部服务与中间件。",
      "tier": 1
    },
    {
      "id": "ns-ingress",
      "parent": "cluster",
      "kind": "NODE_KIND_NAMESPACE",
      "title": "ingress",
      "icon": "namespace",
      "description": "统一入口。",
      "domain": "access"
    },
    {
      "id": "traefik",
      "parent": "ns-ingress",
      "kind": "NODE_KIND_COMPONENT",
      "title": "Traefik",
      "subtitle": "入口 · 自动证书",
      "icon": "traefik",
      "repository": "shop-deploy",
      "source": "traefik",
      "description": "按 Host 与路径路由到前端与各领域 API，证书自动续期，替代 Nginx。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "web",
      "kind": "NODE_KIND_COMPONENT",
      "title": "商城前端",
      "subtitle": "Vue · 单页应用",
      "icon": "vue",
      "repository": "shop-web",
      "source": "src",
      "description": "顾客端与运营后台共用的单页应用。",
      "parent": "ns-ingress"
    },
    {
      "id": "ns-catalog",
      "parent": "cluster",
      "kind": "NODE_KIND_NAMESPACE",
      "title": "catalog",
      "icon": "namespace",
      "description": "商品领域。",
      "domain": "catalog"
    },
    {
      "id": "catalog-service",
      "parent": "ns-catalog",
      "kind": "NODE_KIND_COMPONENT",
      "title": "商品服务",
      "subtitle": "商品 · 库存",
      "icon": "springboot",
      "repository": "shop-catalog",
      "source": "cmd/catalog",
      "description": "从单体拆出的商品与库存服务，商品读取走缓存。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "ns-order",
      "parent": "cluster",
      "kind": "NODE_KIND_NAMESPACE",
      "title": "order",
      "icon": "namespace",
      "description": "订单领域。",
      "domain": "order"
    },
    {
      "id": "order-service",
      "parent": "ns-order",
      "kind": "NODE_KIND_COMPONENT",
      "title": "订单服务",
      "subtitle": "下单 · 支付",
      "icon": "springboot",
      "repository": "shop-order",
      "source": "order",
      "description": "下单时经商品服务扣减库存，调用支付网关并发布订单事件。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "notifier",
      "parent": "ns-order",
      "kind": "NODE_KIND_COMPONENT",
      "title": "通知服务",
      "subtitle": "订阅订单事件",
      "icon": "bell",
      "repository": "shop-order",
      "source": "notifier",
      "description": "消费订单事件发送短信，短信失败不影响下单。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "ns-platform",
      "parent": "cluster",
      "kind": "NODE_KIND_NAMESPACE",
      "title": "platform",
      "icon": "namespace",
      "description": "共用中间件。",
      "domain": "platform"
    },
    {
      "id": "postgres",
      "parent": "ns-platform",
      "kind": "NODE_KIND_COMPONENT",
      "title": "PostgreSQL",
      "subtitle": "按服务分库",
      "icon": "postgresql",
      "repository": "shop-deploy",
      "source": "postgres",
      "description": "商品与订单各用独立的数据库与账号。",
      "change": "CHANGE_REWORKED"
    },
    {
      "id": "valkey",
      "parent": "ns-platform",
      "kind": "NODE_KIND_COMPONENT",
      "title": "Valkey",
      "subtitle": "商品缓存",
      "icon": "valkey",
      "repository": "shop-deploy",
      "source": "valkey",
      "description": "开源的 Redis 兼容缓存，替代 Redis。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "nats",
      "parent": "ns-platform",
      "kind": "NODE_KIND_COMPONENT",
      "title": "NATS JetStream",
      "subtitle": "事件总线",
      "icon": "nats",
      "repository": "shop-deploy",
      "source": "nats",
      "description": "持久化订单事件，消费者可按需重放。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "service-config",
      "parent": "ns-platform",
      "kind": "NODE_KIND_ARTIFACT",
      "title": "服务配置",
      "subtitle": "ConfigMap · Secret",
      "icon": "config",
      "repository": "shop-deploy",
      "source": "services",
      "description": "各服务的连接配置与凭据，由部署仓库下发。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "ns-observability",
      "parent": "cluster",
      "kind": "NODE_KIND_NAMESPACE",
      "title": "observability",
      "icon": "namespace",
      "description": "日志与链路。",
      "domain": "observability"
    },
    {
      "id": "otel-collector",
      "parent": "ns-observability",
      "kind": "NODE_KIND_COMPONENT",
      "title": "OpenTelemetry Collector",
      "subtitle": "OTLP 接收",
      "icon": "opentelemetry",
      "repository": "shop-deploy",
      "source": "observability/collector",
      "description": "接收服务上报的日志与链路，分别写入 Loki 与 Tempo。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "loki",
      "kind": "NODE_KIND_COMPONENT",
      "title": "Loki",
      "subtitle": "日志存储",
      "icon": "loki",
      "repository": "shop-deploy",
      "source": "observability/loki",
      "description": "按标签索引并保存日志。",
      "parent": "ns-observability"
    },
    {
      "id": "tempo",
      "parent": "ns-observability",
      "kind": "NODE_KIND_COMPONENT",
      "title": "Tempo",
      "subtitle": "链路存储",
      "icon": "tempo",
      "repository": "shop-deploy",
      "source": "observability/tempo",
      "description": "保存分布式链路。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "grafana",
      "parent": "ns-observability",
      "kind": "NODE_KIND_COMPONENT",
      "title": "Grafana",
      "subtitle": "日志 · 链路",
      "icon": "grafana",
      "repository": "shop-deploy",
      "source": "observability/grafana",
      "description": "增加链路数据源，日志与链路互相跳转。",
      "change": "CHANGE_REWORKED"
    },
    {
      "id": "ns-dev",
      "parent": "cluster",
      "kind": "NODE_KIND_NAMESPACE",
      "title": "dev",
      "icon": "namespace",
      "description": "测试替身。",
      "domain": "dev"
    },
    {
      "id": "mock-payment",
      "parent": "ns-dev",
      "kind": "NODE_KIND_COMPONENT",
      "title": "支付模拟器",
      "subtitle": "测试环境",
      "icon": "mock",
      "repository": "shop-order",
      "source": "mock",
      "description": "模拟支付网关的成功、失败与超时，只在测试环境部署。",
      "change": "CHANGE_ADDED"
    },
    {
      "id": "payment",
      "kind": "NODE_KIND_EXTERNAL",
      "title": "支付网关",
      "subtitle": "第三方",
      "icon": "plug",
      "description": "处理支付并通知支付结果。",
      "tier": 2
    },
    {
      "id": "sms",
      "kind": "NODE_KIND_EXTERNAL",
      "title": "短信服务",
      "subtitle": "第三方",
      "icon": "message",
      "description": "发送订单通知短信。",
      "tier": 2
    }
  ],
  "edges": [
    {
      "source": "customer",
      "target": "traefik",
      "kind": "EDGE_KIND_REQUEST",
      "label": "HTTPS",
      "description": "访问商城与下单。"
    },
    {
      "source": "operator",
      "target": "traefik",
      "kind": "EDGE_KIND_REQUEST",
      "label": "HTTPS",
      "description": "访问运营后台与看板。"
    },
    {
      "source": "traefik",
      "target": "web",
      "kind": "EDGE_KIND_REQUEST",
      "label": "静态资源",
      "description": "/ 下的前端资源。"
    },
    {
      "source": "traefik",
      "target": "catalog-service",
      "kind": "EDGE_KIND_REQUEST",
      "label": "/api/catalog",
      "description": "商品 API。"
    },
    {
      "source": "traefik",
      "target": "order-service",
      "kind": "EDGE_KIND_REQUEST",
      "label": "/api/orders",
      "description": "订单 API。"
    },
    {
      "source": "traefik",
      "target": "grafana",
      "kind": "EDGE_KIND_REQUEST",
      "label": "/grafana",
      "description": "日志与链路看板。"
    },
    {
      "source": "order-service",
      "target": "catalog-service",
      "kind": "EDGE_KIND_REQUEST",
      "label": "扣减库存",
      "description": "下单时校验并扣减库存。"
    },
    {
      "source": "catalog-service",
      "target": "postgres",
      "kind": "EDGE_KIND_REQUEST",
      "label": "SQL · catalog",
      "description": "商品与库存。"
    },
    {
      "source": "order-service",
      "target": "postgres",
      "kind": "EDGE_KIND_REQUEST",
      "label": "SQL · orders",
      "description": "订单与支付记录。"
    },
    {
      "source": "catalog-service",
      "target": "valkey",
      "kind": "EDGE_KIND_REQUEST",
      "label": "商品缓存",
      "description": "热门商品读缓存。"
    },
    {
      "source": "order-service",
      "target": "nats",
      "kind": "EDGE_KIND_EVENT",
      "label": "订单事件",
      "description": "发布下单、支付与取消事件。"
    },
    {
      "source": "notifier",
      "target": "nats",
      "kind": "EDGE_KIND_EVENT",
      "label": "订阅订单事件",
      "description": "持久订阅，失败重试。"
    },
    {
      "source": "notifier",
      "target": "sms",
      "kind": "EDGE_KIND_REQUEST",
      "label": "短信 API",
      "description": "发送订单通知。"
    },
    {
      "source": "order-service",
      "target": "payment",
      "kind": "EDGE_KIND_REQUEST",
      "label": "支付 API",
      "description": "创建支付单并查询结果。"
    },
    {
      "source": "order-service",
      "target": "mock-payment",
      "kind": "EDGE_KIND_REQUEST",
      "label": "测试支付",
      "description": "测试环境以模拟器替代支付网关。"
    },
    {
      "source": "catalog-service",
      "target": "service-config",
      "kind": "EDGE_KIND_CONFIG",
      "label": "挂载",
      "description": "连接配置与凭据。"
    },
    {
      "source": "order-service",
      "target": "service-config",
      "kind": "EDGE_KIND_CONFIG",
      "label": "挂载",
      "description": "连接配置与凭据。"
    },
    {
      "source": "notifier",
      "target": "service-config",
      "kind": "EDGE_KIND_CONFIG",
      "label": "挂载",
      "description": "连接配置与凭据。"
    },
    {
      "source": "catalog-service",
      "target": "otel-collector",
      "kind": "EDGE_KIND_REQUEST",
      "label": "OTLP",
      "description": "日志与链路。"
    },
    {
      "source": "order-service",
      "target": "otel-collector",
      "kind": "EDGE_KIND_REQUEST",
      "label": "OTLP",
      "description": "日志与链路。"
    },
    {
      "source": "notifier",
      "target": "otel-collector",
      "kind": "EDGE_KIND_REQUEST",
      "label": "OTLP",
      "description": "日志与链路。"
    },
    {
      "source": "otel-collector",
      "target": "loki",
      "kind": "EDGE_KIND_REQUEST",
      "label": "日志",
      "description": "写入日志。"
    },
    {
      "source": "otel-collector",
      "target": "tempo",
      "kind": "EDGE_KIND_REQUEST",
      "label": "链路",
      "description": "写入链路。"
    },
    {
      "source": "grafana",
      "target": "loki",
      "kind": "EDGE_KIND_REQUEST",
      "label": "LogQL",
      "description": "检索日志。"
    },
    {
      "source": "grafana",
      "target": "tempo",
      "kind": "EDGE_KIND_REQUEST",
      "label": "TraceQL",
      "description": "检索链路。"
    }
  ],
  "notes": [
    {
      "title": "按领域拆分单体",
      "description": "商品与订单独立部署、独立数据库，订单经 API 扣减库存。",
      "nodes": ["catalog-service", "order-service", "postgres"]
    },
    {
      "title": "订单事件驱动通知",
      "description": "通知服务订阅订单事件，短信渠道故障不阻塞下单。",
      "nodes": ["order-service", "nats", "notifier"]
    },
    {
      "title": "统一入口",
      "description": "Traefik 按 Host 与路径路由，证书自动续期。",
      "nodes": ["traefik"]
    },
    {
      "title": "OTLP 统一遥测",
      "description": "服务只对接 Collector，后端可替换；日志与链路在 Grafana 中互相跳转。",
      "nodes": ["otel-collector", "loki", "tempo", "grafana"]
    },
    {
      "title": "测试替身只在研发环境",
      "description": "支付模拟器不随生产交付。",
      "nodes": ["mock-payment"]
    }
  ],
  "domains": [
    {
      "id": "access",
      "title": "入口",
      "subtitle": "Traefik · 前端",
      "icon": "entry",
      "description": "统一入口：按 Host 与路径把请求路由到前端与各领域 API。",
      "category": "DOMAIN_CATEGORY_CORE"
    },
    {
      "id": "catalog",
      "title": "商品",
      "subtitle": "商品 · 库存",
      "icon": "inventory",
      "description": "商品资料与库存，供下单校验。",
      "category": "DOMAIN_CATEGORY_CORE"
    },
    {
      "id": "order",
      "title": "订单",
      "subtitle": "下单 · 支付 · 通知",
      "icon": "ticket",
      "description": "下单与支付，以订单事件驱动通知。",
      "category": "DOMAIN_CATEGORY_CORE"
    },
    {
      "id": "platform",
      "title": "平台底座",
      "subtitle": "数据库 · 缓存 · 事件",
      "icon": "platform",
      "description": "各领域共用的有状态中间件与配置。",
      "category": "DOMAIN_CATEGORY_CORE"
    },
    {
      "id": "observability",
      "title": "可观测",
      "subtitle": "日志 · 链路",
      "icon": "telescope",
      "description": "服务以 OTLP 上报日志与链路；缺失时业务不受影响。",
      "category": "DOMAIN_CATEGORY_OPTIONAL"
    },
    {
      "id": "dev",
      "title": "研发",
      "subtitle": "测试替身",
      "icon": "flask",
      "description": "只在测试环境部署的替身服务。",
      "category": "DOMAIN_CATEGORY_DEVELOPMENT"
    }
  ]
}
